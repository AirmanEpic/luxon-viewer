{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "luxon-viewer-tauri",
  "version": "0.1.0",
  "identifier": "com.stefa.luxon-viewer-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.next/build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "luxon-viewer-tauri",
        "width": 1200,
        "height": 900
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
